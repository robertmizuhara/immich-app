# You can find documentation for all the supported env variables at https://docs.immich.app/install/environment-variables

# The location where your uploaded files are stored
UPLOAD_LOCATION=/mnt/Extra_512/immich-backup

# The location where your database files are stored. Network shares are not supported for the database
DB_DATA_LOCATION=/mnt/Extra_512/immich-postgres

# To set a timezone, uncomment the next line and change Etc/UTC to a TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
TZ=America/Los_Angeles

# The Immich version to use. You can pin this to a specific version like "v3.0.3"
IMMICH_VERSION=v3.0.3

# Connection secret for postgres. You should change it to a random password
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD=your_secure_password_here

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Restic backup settings
RESTIC_HOST=your_restic_server_ip
RESTIC_PORT=8000
RESTIC_USER=your_user
RESTIC_PASSWORD=your_password
RESTIC_REPO=rest:http://your_user:your_password@your_host:port/your_path
BACKUP_INTERVAL_MINUTES=15

# Machine Learning settings
MACHINE_LEARNING_REQUEST_THREADS=4
MACHINE_LEARNING_WORKERS=1
MACHINE_LEARNING_MODEL_INTRA_OP_THREADS=4
MACHINE_LEARNING_MODEL_INTER_OP_THREADS=1
